# Port for the Express server. (macOS uses 5000 for AirPlay Receiver, so 5001 is the default here.)
PORT=5001
# Ticketmaster Discovery API key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_api_key_here
# Allowed frontend origin(s) for CORS, comma-separated
FRONTEND_URL=http://localhost:5173
